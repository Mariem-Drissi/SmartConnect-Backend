generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  RESPONSABLE_COMMERCIAL
  COMMERCIAL
  STOCK_MANAGER
  WAREHOUSE_KEEPER
  ACCOUNTANT
  PRODUCTION_MANAGER
  CUSTOM
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  SIGNED
  DELIVERED
  CANCELLED
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitPlanStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum ClientType {
  GMS
  WHOLESALER
  B2B
  B2C
  OCCASIONAL
}

enum InsightType {
  INACTIVITY_RISK
  HIGH_POTENTIAL
  PROSPECT_NEARBY
  SALES_FORECAST
  ANOMALY
}

model PermissionProfile {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@map("permission_profiles")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  password                 String
  firstName                String
  lastName                 String
  phone                    String?
  zone                     String?
  role                     SystemRole                @default(COMMERCIAL)
  isActive                 Boolean                   @default(true)
  permissionProfileId      String?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  permissionProfile        PermissionProfile?        @relation(fields: [permissionProfileId], references: [id])
  createdOrders            SaleOrder[]               @relation("CreatedBy")
  stockMovements           StockMovement[]
  assignedClients          Client[]                  @relation("AssignedCommercial")
  visitPlans               VisitPlan[]
  visits                   Visit[]
  salesTargets             SalesTarget[]
  prospects                Prospect[]
  commercialStocks         CommercialStock[]
  commercialStockMovements CommercialStockMovement[] @relation("PerformedBy")

  @@map("users")
}

model ProductCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  color       String?
  createdAt   DateTime  @default(now())
  products    Product[]

  @@map("product_categories")
}

model Product {
  id               String            @id @default(uuid())
  name             String
  flavor           String?
  sku              String            @unique
  description      String?
  weightGrams      Int?
  unitPrice        Decimal           @db.Decimal(10, 2)
  costPrice        Decimal           @db.Decimal(10, 2)
  isActive         Boolean           @default(true)
  isArchived       Boolean           @default(false)
  archivedAt       DateTime?
  imageUrl         String?
  categoryId       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  category         ProductCategory?  @relation(fields: [categoryId], references: [id])
  stock            ProductStock?
  orderItems       SaleOrderItem[]
  commercialStocks CommercialStock[]

  @@map("products")
}

model ProductStock {
  id           String          @id @default(uuid())
  productId    String          @unique
  quantity     Int             @default(0)
  minThreshold Int             @default(50)
  updatedAt    DateTime        @updatedAt
  product      Product         @relation(fields: [productId], references: [id])
  movements    StockMovement[]

  @@map("product_stocks")
}

// Stock assigné individuellement à chaque commercial (van/tournée) — distinct du dépôt central (ProductStock)
model CommercialStock {
  id           String                    @id @default(uuid())
  userId       String
  productId    String
  quantity     Int                       @default(0)
  minThreshold Int                       @default(10)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product                   @relation(fields: [productId], references: [id])
  movements    CommercialStockMovement[]

  @@unique([userId, productId])
  @@map("commercial_stocks")
}

model CommercialStockMovement {
  id                String            @id @default(uuid())
  commercialStockId String
  type              StockMovementType
  quantity          Int
  reason            String?
  reference         String?
  performedBy       String
  createdAt         DateTime          @default(now())
  commercialStock   CommercialStock   @relation(fields: [commercialStockId], references: [id], onDelete: Cascade)
  user              User              @relation("PerformedBy", fields: [performedBy], references: [id])

  @@map("commercial_stock_movements")
}

model StockMovement {
  id          String            @id @default(uuid())
  stockId     String
  type        StockMovementType
  quantity    Int
  reason      String?
  reference   String?
  performedBy String
  createdAt   DateTime          @default(now())
  stock       ProductStock      @relation(fields: [stockId], references: [id])
  user        User              @relation(fields: [performedBy], references: [id])

  @@map("stock_movements")
}

model Client {
  id             String       @id @default(uuid())
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  region         String?
  postalCode     String?
  latitude       Float?
  longitude      Float?
  clientType     ClientType   @default(B2B)
  taxId          String?
  assignedUserId String?
  isActive       Boolean      @default(true)
  isArchived     Boolean      @default(false)
  archivedAt     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  commercial     User?        @relation("AssignedCommercial", fields: [assignedUserId], references: [id])
  clientScore    ClientScore?
  orders         SaleOrder[]
  visits         Visit[]
  aiInsights     AIInsight[]

  @@map("clients")
}

model Prospect {
  id                String            @id @default(uuid())
  name              String
  email             String?
  phone             String?
  address           String?
  city              String?
  region            String?
  latitude          Float?
  longitude         Float?
  status            ProspectStatus    @default(NEW)
  potentialValue    Decimal?          @db.Decimal(12, 2)
  source            String?
  notes             String?
  assignedUserId    String?
  convertedClientId String?
  lostReason        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  assignedUser      User?             @relation(fields: [assignedUserId], references: [id])
  history           ProspectHistory[]

  @@map("prospects")
}

model ProspectHistory {
  id         String   @id @default(uuid())
  prospectId String
  action     String
  notes      String?
  createdAt  DateTime @default(now())
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@map("prospect_history")
}

model ClientScore {
  id              String   @id @default(uuid())
  clientId        String   @unique
  inactivityScore Float    @default(0)
  potentialScore  Float    @default(0)
  lastOrderDays   Int?
  orderFrequency  Float?
  avgOrderValue   Float?
  totalRevenue    Float    @default(0)
  calculatedAt    DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("client_scores")
}

model AIInsight {
  id          String      @id @default(uuid())
  clientId    String?
  type        InsightType
  title       String
  description String
  score       Float?
  metadata    Json?
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("ai_insights")
}

model SalesTarget {
  id           String   @id @default(uuid())
  userId       String
  month        Int
  year         Int
  targetAmount Decimal  @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("sales_targets")
}

model Visit {
  id           String      @id @default(uuid())
  clientId     String
  userId       String
  visitPlanId  String
  order        Int         @default(0)
  distanceKm   Float?
  status       VisitStatus @default(PLANNED)
  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  report       String?
  nextAction   String?
  orderCreated Boolean     @default(false)
  orderAmount  Decimal?    @db.Decimal(12, 2)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  client       Client      @relation(fields: [clientId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
  visitPlan    VisitPlan   @relation(fields: [visitPlanId], references: [id], onDelete: Cascade)

  @@map("visits")
}

// Une "tournée" — une visite fait toujours partie d'une tournée (assignée par l'admin/responsable commercial)
model VisitPlan {
  id            String          @id @default(uuid())
  userId        String
  date          DateTime
  status        VisitPlanStatus @default(DRAFT)
  title         String?
  notes         String?
  isOptimized   Boolean         @default(false)
  totalDistance Float?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id])
  visits        Visit[]

  @@map("visit_plans")
}

model SaleOrder {
  id            String          @id @default(uuid())
  reference     String          @unique
  clientId      String
  status        OrderStatus     @default(DRAFT)
  totalAmount   Decimal         @default(0) @db.Decimal(12, 2)
  notes         String?
  deliveryDate  DateTime?
  signatureData String?
  signedAt      DateTime?
  invoiceUrl    String?
  createdById   String
  isArchived    Boolean         @default(false)
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  client        Client          @relation(fields: [clientId], references: [id])
  createdBy     User            @relation("CreatedBy", fields: [createdById], references: [id])
  items         SaleOrderItem[]

  @@map("sale_orders")
}

model SaleOrderItem {
  id          String    @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(10, 2)
  subtotal    Decimal   @db.Decimal(12, 2)
  order       SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("sale_order_items")
}
